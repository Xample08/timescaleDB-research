{
  "version": 2,
  "builds": [
    {
      "src": "dashboard/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "simulator/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/dashboard(?:/(.*))?",
      "dest": "dashboard"
    },
    {
      "src": "/simulator(?:/(.*))?",
      "dest": "simulator"
    }
  ]
}
