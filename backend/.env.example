# Copy to backend/.env and fill in. Never commit backend/.env.

# Required. postgres://user:pass@host:port/db?sslmode=require
TIGER_CONNECTION_STRING=postgres://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require

# Optional read-only role for dashboard reads (falls back to TIGER_CONNECTION_STRING).
# READONLY_CONNECTION_STRING=

# If unset, all /api/admin/* endpoints return 403.
# ADMIN_TOKEN=

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

DB_POOL_SIZE=5
SIM_MAX_VEHICLES=1000
SIM_MIN_INTERVAL_SECONDS=1
SIM_DEFAULT_MAX_ROWS=1000000
BENCH_STATEMENT_TIMEOUT_SECONDS=120
CAGG_REFRESH_INTERVAL_SECONDS=60
